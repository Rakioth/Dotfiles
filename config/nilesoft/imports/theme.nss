theme
{
	name = 'modern'
	view = view.small

	background
	{
		color   = #000000
		opacity = 85
		effect  = 1
	}

	item
	{
		opacity = 85
		prefix  = 1

		text
		{
			normal          = #d5ced9
			select          = #d5ced9
			normal-disabled = #5f6167
			select-disabled = #5f6167
		}

		back
		{
			select          = #262626
			select-disabled = #1e1e1e
		}
	}

	border
	{
		enabled = true
		size    = 1
		color   = #891798
		opacity = 100
		radius  = 2
	}

	shadow
	{
		enabled = true
		size    = 5
		opacity = 5
		color   = #891798
	}

	separator
	{
		size  = 1
		color = #891798
	}

	symbol
	{
		normal          = #c698f2
		select          = #c698f2
		normal-disabled = #5f6167
		select-disabled = #5f6167
	}

	image
	{
		enabled = true
		color   = [#c698f2, #ce3ed6]
	}
}
